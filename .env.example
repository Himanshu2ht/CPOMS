SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=mysql+pymysql://canteen_user:StrongPassword@localhost:3306/canteen_db
PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret
# Business rules (minutes)
PREP_TIME_MINUTES=25
CANCEL_WINDOW_MINUTES=5
PICKUP_GRACE_MINUTES=60
# 1 = fall back to local instance/canteen.db when MySQL is unreachable (dev); 0 = fail loudly
DB_FALLBACK_SQLITE=1
# Set to 1 when serving behind HTTPS so the session cookie is Secure
SESSION_COOKIE_SECURE=0
